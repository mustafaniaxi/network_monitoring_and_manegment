# Copy to .env and adjust. Every backend setting is NETMON_<NAME>; see docs/configuration.md.

# --- required ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NETMON_SECRET_KEY=replace-with-a-long-random-string-of-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-strong-database-password
NETMON_FIRST_ADMIN_EMAIL=admin@example.com
NETMON_FIRST_ADMIN_PASSWORD=replace-me-on-first-login

# --- general ----------------------------------------------------------------
NETMON_ENVIRONMENT=production
NETMON_LOG_LEVEL=INFO
NETMON_HTTP_PORT=8080
NETMON_PUBLIC_URL=http://localhost:8080
POSTGRES_DB=netmon
POSTGRES_USER=netmon

# --- monitoring engine --------------------------------------------------------
# live = real ICMP/TCP/SNMP; simulation = synthetic network for demos
NETMON_MONITOR_MODE=live
NETMON_POLL_INTERVAL_SECONDS=30
NETMON_DOWN_AFTER_FAILURES=2
NETMON_MAX_CONCURRENT_POLLS=64
NETMON_METRICS_RETENTION_DAYS=90

# --- notifications (optional) ---------------------------------------------------
# Slack/Mattermost/Discord-compatible incoming webhook
NETMON_ALERT_WEBHOOK_URL=
NETMON_ALERT_MIN_SEVERITY=warning
NETMON_SMTP_HOST=
NETMON_SMTP_PORT=587
NETMON_SMTP_USERNAME=
NETMON_SMTP_PASSWORD=
NETMON_SMTP_FROM=netmon@example.com
# comma separated
NETMON_SMTP_TO=
